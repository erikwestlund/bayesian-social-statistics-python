# What stays out of git, and why
#
# The NCES data: each user downloads them with scripts/*/01_fetch and accepts the
# NCES data usage agreement, and the files are large.
/inputs/raw/els/
/inputs/raw/hsls/
# The NCES documentation PDFs: large, and NCES hosts them. shared/
# data_locations.csv records where each one comes from.
/inputs/raw/els_docs/
/inputs/raw/hsls_docs/
# Files built from the raw data by scripts/*/02_clean: large, and anyone can rebuild
# them.
/inputs/intermediate/
/inputs/final/
# Rendered notebooks, figures, tables, and models: rebuilt from the code.
/outputs/

# ============================================================================
# SECRETS AND CREDENTIALS - NEVER COMMIT
# ============================================================================

.env
.env.local
.env.*.local
.Renviron
.httr-oauth
**/credentials/**
**/secrets/**
*.key
*.pem
*.p12
*.pfx

# ============================================================================
# UTILITY & CACHE - SAFE TO IGNORE
# ============================================================================

# Temporary processing directories
**/cache/**
**/scratch/**
**/tmp/**
**/temp/**

# Logs (run logs, cluster job output)
**/logs/**
slurm-*.out

# ============================================================================
# FRAMEWORK INTERNALS
# ============================================================================

framework.db
framework.db-wal
framework.db-shm
.initiated
.framework_scaffolded

# ============================================================================
# QUARTO ARTIFACTS
# ============================================================================

# Quarto adds these two lines, in this form, unless they are here already
/.quarto/
**/*.quarto_ipynb
# A folder with its own _quarto.yml gets its own .quarto/
.quarto/
_freeze/
# Backups from quarto_regenerate() before framework-py 0.1.0.dev13
.quarto_backups/
*_cache/
*_files/

# ============================================================================
# PYTHON ENVIRONMENT
# ============================================================================

__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ============================================================================
# IDE & SYSTEM FILES
# ============================================================================

# IDE - personal settings only (commit workspace settings if desired)
.idea/
.vscode/.history/
.positron/.history/
.history/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# Linux
*~

# ============================================================================
# CLOUD/AWS CONFIG
# ============================================================================

.aws/
.config/

# ============================================================================
# TEMPORARY FILES
# ============================================================================

*.tmp
*.log
*.bak
*.swp
*~

# --- from base framework/project_sensitive v5 ---
# Credentials
.env
.env.*
!.env.example
.Renviron
**/credentials/**
**/secrets/**

# Local records and caches
framework.db
framework.db-wal
framework.db-shm
.DS_Store

# Run logs
/logs/

# Compiled Stan programs: keep the .stan sources only
/stan/*
!/stan/*.stan
